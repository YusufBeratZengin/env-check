# Application port
# @type port
# @default 3000
PORT=3000

# Application environment
# @type enum(development,staging,production)
# @default development
NODE_ENV=development

# Database connection URL
# @type url
# @secret
# @required
DATABASE_URL=

# Admin notification email
# @type email
# @required
ADMIN_EMAIL=

# Cache TTL duration
# @type duration
# @default 10m
CACHE_TTL=10m

# Enable debug mode
# @type bool
# @default false
DEBUG=false

# API key matching specific pattern
# @pattern /^sk_[a-z0-9]{12}$/
# @secret
# @required
API_KEY=
