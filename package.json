{
  "name": "env-check",
  "version": "0.1.0",
  "description": "Validate environment variables and .env files against schemas without leaking secrets",
  "keywords": [
    "env",
    "dotenv",
    "validate",
    "schema",
    "security",
    "secret",
    "ci",
    "zero-dependencies"
  ],
  "homepage": "https://github.com/YusufBeratZengin/env-check#readme",
  "bugs": {
    "url": "https://github.com/YusufBeratZengin/env-check/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YusufBeratZengin/env-check.git"
  },
  "license": "MIT",
  "author": "Yusuf Berat Zengin",
  "type": "module",
  "main": "./src/index.js",
  "bin": {
    "env-check": "./bin/env-check.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-reporter=./scripts/coverage-reporter.mjs",
    "check": "node bin/env-check.js check",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --project jsconfig.json",
    "demo": "node scripts/make-demo.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
